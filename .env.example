APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Model routing
ORCHESTRATOR_PROVIDER=ollama
ORCHESTRATOR_MODEL=qwen3:8b
SYNTHESIS_PROVIDER=ollama
SYNTHESIS_MODEL=medgemma:27b
EXTRACTOR_PROVIDER=ollama
EXTRACTOR_MODEL=medgemma1.5:4b
VISION_PROVIDER=ollama
VISION_MODEL=medgemma:27b

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Remote/OpenAI-compatible MedGemma endpoint (optional)
MEDGEMMA_REMOTE_BASE_URL=
MEDGEMMA_REMOTE_API_KEY=
MEDGEMMA_REMOTE_TEXT_MODEL=google/medgemma-27b-text-it
MEDGEMMA_REMOTE_VISION_MODEL=google/medgemma-27b-it

# Public clinical APIs
NCBI_EMAIL=
NCBI_API_KEY=
CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2
OPENFDA_BASE_URL=https://api.fda.gov
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
DAILYMED_BASE_URL=https://dailymed.nlm.nih.gov/dailymed/services/v2

# Retrieval defaults
PUBMED_TOP_K=8
TRIAL_TOP_K=8
MAX_AGENT_STEPS=10
REQUEST_TIMEOUT_SECONDS=20
